# 비밀 아닌 배포 선언(taebro-infra 계약 v5 4절). bin/deploy 는 이 파일을 source 하지 않고 아래 키만 읽는다.
HEALTH_PATH=/health
# 헬스 본문에 있어야 할 문자열 — main.py /health 의 "service" 값. 포트가 엉뚱한 앱에 붙어 200 이 나는 거짓 통과를 막는다
HEALTH_EXPECT=portfolion
# 기동 배치 동안 포트가 ~5분 안 열린다(deploy-ops 실측, task#250) — 기본 120초면 정상 기동을 실패로 롤백한다
HEALTH_TIMEOUT=600
# BUILD_SERVICES — 기본(전체: backend nginx)
# compose 에 상대경로 마운트가 없다(프론트·nginx.conf 는 이미지에 굽는다). deploy/dev-db.compose.yml 은 dev 만
# 실행 자리 .env 의 COMPOSE_FILE 로 읽는다(backend → taebro-db, task#387) — prod 실행 자리에도 복사되지만 읽히지 않는다
# 루틴 fire 리스너(launchd)는 작업 폴더가 아니라 prod 실행 자리의 사본을 돌린다 — 프롬프트도 같은 scripts/ 에서 읽는다
RUNTIME_FILES=docker-compose.yml deploy/dev-db.compose.yml scripts/cowork-fire-listener.py scripts/cowork-routine-prompt.md
