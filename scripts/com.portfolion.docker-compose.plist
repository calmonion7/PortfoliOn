<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>com.portfolion.docker-compose</string>

		<!-- 정본 경로. 옛 판은 삭제된 워크트리
		     (.claude/worktrees/docker-infra-migration/scripts/start-docker-compose.sh)를
		     가리켜 exit 127(command not found)로 죽어 있었다. -->
		<key>ProgramArguments</key>
		<array>
			<string>/bin/bash</string>
			<string>/Users/calmonion/Project/PortfoliOn/scripts/start-docker-compose.sh</string>
		</array>

		<!-- launchd 최소환경에는 이 넷이 없다. docker 는 /usr/local/bin 에,
		     node/npm(deploy.sh 의 프론트 빌드가 쓴다)은 fnm default alias 에 있다.
		     ⚠️ fnm 의 세션별 multishell 경로(.../fnm_multishells/...)를 넣지 말 것 — 세션마다 바뀐다.
		     이 값은 동작 중인 형제 잡 com.portfolion.cowork-fire-listener 의 검증된 값과 동일하다. -->
		<key>EnvironmentVariables</key>
		<dict>
			<key>HOME</key>
			<string>/Users/calmonion</string>
			<key>USER</key>
			<string>calmonion</string>
			<key>LOGNAME</key>
			<string>calmonion</string>
			<key>PATH</key>
			<string>/Users/calmonion/.local/share/fnm/aliases/default/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		</dict>

		<key>RunAtLoad</key>
		<true/>
		<key>StandardOutPath</key>
		<string>/Users/calmonion/Library/Logs/com.portfolion.docker-compose.out.log</string>
		<key>StandardErrorPath</key>
		<string>/Users/calmonion/Library/Logs/com.portfolion.docker-compose.err.log</string>
	</dict>
</plist>
